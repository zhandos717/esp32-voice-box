# Скопируйте в .env (он в .gitignore) и впишите свои значения. В чат и в репозиторий их не отправляйте.
TELEGRAM_BOT_TOKEN=токен_от_BotFather
# числовой ID вашего чата: бот в режиме привязки пришлёт его в ответ на любое сообщение
TELEGRAM_CHAT_ID=
# номер топика группы-форума (команда /id в топике); пусто, если топиков нет
TELEGRAM_THREAD_ID=

# необязательно
# MIC_REC_DIR=C:\путь\к\записям
# MIC_GAIN=4
# MIC_MAX_SECONDS=300
# MIC_REMIND_SECONDS=5
# FFMPEG=C:\путь\к\ffmpeg.exe

# озвучка текстовых сообщений: Azure AI Speech (бесплатный тариф F0) или Piper без облака
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# AZURE_SPEECH_VOICE=ru-RU-SvetlanaNeural
# AZURE_SPEECH_VOICE_KK=kk-KZ-AigulNeural   если в тексте есть казахские буквы
# TTS_PITCH=+40Hz        только Azure
# TTS_RATE=+15%          только Azure
# TTS_EFFECT=chipmunk    chipmunk, chipmunk-light, chipmunk-high, chipmunk-bright или robot, нужен ffmpeg
# TTS_PITCH_KK=none      свои настройки для казахского текста; none выключает общую
# TTS_EFFECT_KK=chipmunk
# PIPER=/opt/piper/piper/piper
# PIPER_MODEL=/opt/piper/voices/ru_RU-irina-medium.onnx
